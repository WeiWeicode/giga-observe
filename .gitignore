# ==============================================================================
# Environment Variables & Secrets (切勿上傳敏感金鑰與密碼)
# ==============================================================================
.env
.env.*
*.env
!.env.example
!.env.*.example
backend/.env
frontend/.env

# ==============================================================================
# Dependencies (套件相依目錄)
# ==============================================================================
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# ==============================================================================
# Build & Output (前端編譯輸出與快取)
# ==============================================================================
dist/
frontend/dist/
build/
out/
.vite/
*.tsbuildinfo

# ==============================================================================
# Database Data Volumes (本地資料庫實體檔案與 Volume，絕對不可上傳)
# ==============================================================================
data/mongo/*
!data/mongo/.gitkeep
data/redis/*
!data/redis/.gitkeep

# Database engine file extensions & internal folders
*.rdb
*.wt
appendonlydir/
diagnostic.data/
WiredTiger*
mongod.lock
storage.bson
_mdb_catalog.wt
sizeStorer.wt

# ==============================================================================
# Backup Archives (備份壓縮檔)
# ==============================================================================
backup/archives/*
!backup/archives/.gitkeep
*.tar.gz
*.gz
*.dump
*.backup

# ==============================================================================
# Logs & Debugging
# ==============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================================================================
# IDE & System Files
# ==============================================================================
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# VS Code / JetBrains / Editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# AI / IDE Agent
.gemini/
.agents/
.system_generated/

# 本機示範環境的 Key(npm run dev:local)
backend/.local-keys.json

# 各部署區的資料與備份(docker-compose 以 OBSERVE_ENV 分目錄,D2)
data/*/
!data/mongo/
!data/redis/
backup/archives/*/
