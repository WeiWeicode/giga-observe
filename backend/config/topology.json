      "stack": ["MongoDB 7"],
      "team": "IT",
      "owner": "—",
      "status": "active",
      "links": { "repo": "RustIt/ItAgentBack" },
      "monitor": { "enabled": false }
    },
    {
      "id": "ita-redis",
      "name": "端點在線狀態",
      "type": "cache",
      "layer": "data",
      "description": "ItAgentBack 的 Redis 7(ita-redis):在線狀態與內容 hash",
      "stack": ["Redis 7"],
      "team": "IT",
      "owner": "—",
      "status": "active",
      "links": { "repo": "RustIt/ItAgentBack" },
      "monitor": { "enabled": false }
    }
  ],
  "edges": [
