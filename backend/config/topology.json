{
  "services": [
    {
      "id": "itapp-web",
      "name": "IT 管理系統前端",
      "type": "frontend",
      "layer": "presentation",
      "description": "GigaItApp 前端(Vue 3,/it/),健康度由 web-kit 回報、Nginx 託管頁面以探測確認",
      "stack": ["Vue 3", "Vite", "@giganexus/web-kit"],
      "team": "IT",
      "owner": "—",
      "status": "active",
      "links": { "repo": "GigaItApp/frontend" },
      "monitor": { "healthUrl": "https://giganexus-test.gigasolar.com.tw/it/", "enabled": true }
    },
    {
      "id": "portal-web",
      "name": "員工入口網前端",
      "type": "frontend",
      "layer": "presentation",
      "description": "giga-Portal 前端(/,含登入頁)",
      "stack": ["Vue 3", "Vite", "@giganexus/web-kit"],
      "team": "IT",
      "owner": "—",
      "status": "active",
      "links": { "repo": "giga-Portal/frontend" },
      "monitor": { "healthUrl": "https://giganexus-test.gigasolar.com.tw/", "enabled": true }
    },
    {
      "id": "gw-nginx",
      "name": "Gateway Nginx",
      "type": "gateway",
      "layer": "api",
      "description": "全平台入口(:443 / :9443);流量與來源 IP 由 nginx-log-agent 每分鐘彙總回報",
      "stack": ["Nginx 1.26"],
      "team": "IT",
      "owner": "—",
      "status": "active",
      "links": { "repo": "giga-api-gateway-bff/nginx" },
      "monitor": { "healthUrl": "http://nginx:8081/stub_status", "enabled": true }
    },
    {
      "id": "gw-bff",
      "name": "Gateway BFF",
      "type": "backend",
      "layer": "api",
      "description": "登入、權限、動態路由、通知;每筆請求(含轉送上游的 routeCode / upstream)經 backend-sdk 回報",
      "stack": ["Node.js 22", "Fastify 5", "SQL Server", "Redis"],
      "team": "IT",
      "owner": "—",
      "status": "active",
      "links": { "repo": "giga-api-gateway-bff/bff" },
      "monitor": { "healthUrl": "http://bff-1:3000/healthz", "enabled": true }
    },
    {
      "id": "itapp-api",
      "name": "IT 管理系統後端",
      "type": "backend",
      "layer": "api",
      "description": "GigaItApp 後端(/api/it/* 經 BFF)",
      "stack": ["Node.js 22", "Fastify 5"],
      "team": "IT",
      "owner": "—",
      "status": "active",
      "links": { "repo": "GigaItApp/backend" },
      "monitor": { "healthUrl": "http://itapp-api:51291/healthz", "enabled": true }
    },
    {
      "id": "node-sample",
      "name": "後端樣本",
      "type": "backend",
      "layer": "api",
      "description": "samples/node-backend(/api/sample/*),示範 setupGateway 一鍵接入",
      "stack": ["Node.js 22", "Fastify 5"],
      "team": "IT",
      "owner": "—",
      "status": "planned",
      "links": { "repo": "giga-api-gateway-bff/samples/node-backend" },
      "monitor": { "healthUrl": "http://node-sample:51201/healthz", "enabled": false }
    },
    {
      "id": "gw-worker",
      "name": "BFF Worker",
      "type": "devops",
      "layer": "service",
      "description": "通知、Webhook、人員同步佇列;排程以 monitor.job() 回報",
      "stack": ["Node.js 22", "BullMQ"],
      "team": "IT",
      "owner": "—",
      "status": "active",
      "links": { "repo": "giga-api-gateway-bff/bff/src/worker.ts" },
      "monitor": { "enabled": false }
    },
    {
      "id": "observe-api",
      "name": "觀測服務",
      "type": "backend",
      "layer": "service",
      "description": "giga-observe:紀錄、心跳、流量彙總、告警(本服務)",
      "stack": ["Node.js 22", "Express", "MongoDB 7", "Redis 7"],
      "team": "IT",
      "owner": "—",
      "status": "active",
      "links": { "repo": "giga-observe/backend" },
      "monitor": { "healthUrl": "http://localhost:51202/health", "enabled": true }
    },
    {
      "id": "gw-sqlserver",
      "name": "Gateway 資料庫",
      "type": "database",
      "layer": "data",
      "description": "SQL Server(giganexus_gw_test);狀態由 BFF 心跳的 deps 回報",
      "stack": ["SQL Server 2012"],
      "team": "DBA",
      "owner": "—",
      "status": "active",
      "links": {},
      "monitor": { "enabled": false }
    },
    {
      "id": "gw-redis",
      "name": "Gateway Redis",
      "type": "cache",
      "layer": "data",
      "description": "權限快取、Session、佇列;狀態由 BFF 心跳的 deps 回報",
      "stack": ["Redis 7"],
      "team": "IT",
      "owner": "—",
      "status": "active",
      "links": {},
      "monitor": { "enabled": false }
    },
    {
      "id": "gno-mongo",
      "name": "觀測資料庫",
      "type": "database",
      "layer": "data",
      "description": "giga-observe 自有 MongoDB(各部署區獨立)",
      "stack": ["MongoDB 7"],
      "team": "IT",
      "owner": "—",
      "status": "active",
      "links": {},
      "monitor": { "enabled": true, "type": "internal", "check": "mongo" }
    },
    {
      "id": "gno-redis",
      "name": "觀測快取",
      "type": "cache",
      "layer": "data",
      "description": "giga-observe 自有 Redis(各部署區獨立)",
      "stack": ["Redis 7"],
      "team": "IT",
      "owner": "—",
      "status": "active",
      "links": {},
      "monitor": { "enabled": true, "type": "internal", "check": "redis" }
    },
    {
      "id": "gno-backup",
      "name": "觀測備份排程",
      "type": "devops",
      "layer": "infra",
      "description": "每日 mongodump,保留 30 份",
      "stack": ["mongodump"],
      "team": "IT",
      "owner": "—",
      "status": "active",
      "links": {},
      "monitor": { "enabled": false }
    },
    {
      "id": "endpoint-api",
      "name": "端點管理 API",
      "type": "backend",
      "layer": "api",
      "description": "RustIt ItAgentBack 管理 API(/api/endpoint/* 經 BFF:電腦清單、詳情)",
      "stack": ["Node.js 22", "Fastify 5"],
      "team": "IT",
      "owner": "—",
      "status": "active",
      "links": { "repo": "RustIt/ItAgentBack" },
      "monitor": { "healthUrl": "http://endpoint-server:51240/healthz", "enabled": true }
    },
    {
      "id": "endpoint-agent",
      "name": "端點 Agent 通道",
      "type": "backend",
      "layer": "api",
      "description": "RustIt ItAgentBack :51241(Gateway :9443 mTLS 轉入):HTTPS 回報逐筆、WebSocket 每條連線關閉時一筆(method WS);心跳附在線連線數。TLS 為臨時憑證,不主動探測,以心跳判定",
      "stack": ["Node.js 22", "Fastify 5", "WebSocket"],
      "team": "IT",
      "owner": "—",
      "status": "active",
      "links": { "repo": "RustIt/ItAgentBack" },
      "monitor": { "enabled": false }
    },
    {
      "id": "ita-sqlserver",
      "name": "端點資料庫",
      "type": "database",
      "layer": "data",
      "description": "SQL Server 2012 giganexus_It_Agent(測試區 _test):裝置、最新資產、網卡、稽核;唯一真相",
      "stack": ["SQL Server 2012"],
      "team": "IT",
      "owner": "—",
      "status": "active",
      "links": { "repo": "RustIt/ItAgentBack/db" },
      "monitor": { "enabled": false }
    },
    {
      "id": "ita-mongo",
      "name": "端點快照歷史",
      "type": "database",
      "layer": "data",
