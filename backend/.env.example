# 複製為 backend/.env.test(測試區)或 backend/.env.prod(正式區),兩區的密碼、API Key 必須不同(MONITORING-PLAN D2)
# 本機開發:複製為 backend/.env,OBSERVE_ENV=dev
# ── 服務 ────────────────────────────────
NODE_ENV=production
# 部署區:dev / test / prod;資料庫名稱、Redis 前綴預設帶部署區(giga_observe_test、gno-test)
OBSERVE_ENV=test
PORT=51202
SSE_PORT=51203
PROJECT_ID=giganexus

# ── MongoDB ─────────────────────────────
MONGO_INITDB_ROOT_USERNAME=gno_root
MONGO_INITDB_ROOT_PASSWORD=ChangeMe_Mongo_2026
MONGO_URI=mongodb://gno_root:ChangeMe_Mongo_2026@gno-mongo:27017/?authSource=admin
# 留空 = giga_observe_{OBSERVE_ENV}
MONGO_DB=

# ── Redis ───────────────────────────────
REDIS_HOST=gno-redis
REDIS_PORT=6379
REDIS_PASSWORD=ChangeMe_Redis_2026
# 留空 = gno-{OBSERVE_ENV}
REDIS_PREFIX=

# ── 監控參數 ─────────────────────────────
HEARTBEAT_TIMEOUT_SEC=90
PROBE_INTERVAL_SEC=30
PROBE_TIMEOUT_MS=5000
STATUS_EVAL_INTERVAL_SEC=15
ERROR_RATE_THRESHOLD=0.05
LOG_TTL_DAYS=7
# 錯誤紀錄永久;完整 body 保留天數,之後裁成 1 KB 摘要(D13)
ERROR_BODY_DAYS=90
# Nginx 流量彙總、前端效能資料保留天數(D9)
TRAFFIC_TTL_DAYS=90
BODY_SUMMARY_BYTES=1024
BODY_MAX_BYTES=32768

# ── 限制 ────────────────────────────────
INGEST_BATCH_MAX=100
REDIS_LIST_MAX=1000
SSE_MAX_CONNECTIONS=20
SSE_SNAPSHOT_INTERVAL_SEC=30
RATE_LIMIT_INGEST_PER_MIN=600
RATE_LIMIT_HEARTBEAT_PER_MIN=10
RATE_LIMIT_QUERY_PER_MIN=300

# ── 存取控制 ─────────────────────────────
# 查詢端點的 IP 白名單，留空 = 不限制
# ⚠ 在 Docker Desktop（Windows/Mac）環境下後端看到的是橋接閘道 IP 而非真實客戶端 IP，
#   此時填入任何值都會導致全部請求被擋。部署前先照 DEPLOYMENT.md §6 實測。
ALLOWED_QUERY_IPS=

# 是否信任 X-Forwarded-For。5132/5133 直接對外時必須為 false，
# 否則任何人送一個假的 header 就能繞過上面的 IP 白名單。
TRUST_PROXY=false

# CORS 允許的來源，留空 = 全開（開發環境）
# 自帶前端已移除(D10),一般維持空白
CORS_ORIGINS=

# ── 備份 ────────────────────────────────
BACKUP_CRON_HOUR=3
BACKUP_KEEP=30
BACKUP_DIR=/backup

# 備份容器要回報狀態給平台，需要一把 ingest Key。
# 留空的話備份仍會正常執行，但架構圖上的「備份排程」節點會一直是灰色的「尚未回報」，
# 備份失敗時也不會有任何地方看得到。
#
# 產生方式（平台起來之後執行，明文只會顯示一次）：
#   docker compose --env-file deploy/test.env exec gno-backend node src/scripts/createApiKey.js \
#     --service gno-backup --scope ingest --label "備份排程"
# 填好後重新建立備份容器即可生效：docker compose --env-file deploy/test.env up -d gno-backup
BACKUP_API_KEY=
BACKUP_REPORT_ENDPOINT=http://gno-backend:51202

# ── Gateway(GigaItApp 架構觀測頁經 BFF 轉入)────────────
# BFF 的 JWKS(驗證 X-Internal-Token);同一 Docker 網路時用 http://nginx/.well-known/jwks.json 或 Gateway 對外網址
GW_JWKS_URL=
# 本服務在 Gateway 的服務代碼(= Token 的 aud)
GW_SERVICE_CODE=observe-api
# 「API 呼叫」以入口服務計算(同一請求 BFF 與後端各記一筆,只算入口)
ENTRY_SERVICE_ID=gw-bff

# ── 告警門檻(GET /api/v1/alerts,近 15 分鐘)──────────────
ALERT_SECURITY_PER_MIN=30
ALERT_IP_PER_MIN=600
ALERT_WEB_ERRORS_PER_15M=20
